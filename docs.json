            ]
          },
          {
            "group": "Goals & Funnels",
            "pages": [
              "goals/goals-overview",
              "goals/funnels"
            ]
          },
          {
            "group": "Sharing & Integrations",
            "pages": [
              "sharing/shareable-dashboards",
